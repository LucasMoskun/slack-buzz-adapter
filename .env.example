# Slack credentials. Never commit real tokens.
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# One-channel demo mapping.
SLACK_CHANNEL_ID=C0123456789
BUZZ_CHANNEL_ID=00000000-0000-0000-0000-000000000000

# Buzz CLI authentication. BUZZ_AUTH_TAG is optional for message publishing.
BUZZ_RELAY_URL=wss://your-relay.example
BUZZ_PRIVATE_KEY=nsec1...
# BUZZ_AUTH_TAG=["auth","..."]

# Optional settings.
# BUZZ_CLI=buzz
# STATE_PATH=.data/state.json
# ADAPTER_LABEL=Slack mirror
# LOG_LEVEL=info
